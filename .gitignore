# See https://help.github.com/articles/ignoring-files/ for about ignoring files.

# ---------------- dependencies ----------------
node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# ---------------- testing ----------------
/coverage

# ---------------- next.js ----------------
/.next/
/out/

# ---------------- production ----------------
/build

# ---------------- misc ----------------
.DS_Store
*.pem

# ---------------- debug ----------------
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ---------------- env files (do NOT commit secrets) ----------------
.env
.env.local
.env.*.local

# keep the example committed
!.env.example

# ---------------- vercel ----------------
.vercel

# ---------------- typescript ----------------
*.tsbuildinfo
next-env.d.ts

# ---------------- local-only ----------------
local-*
.claude
.z-ai-config

# ---------------- logs ----------------
*.log
dev.log
dev.out.log
server.log

# ---------------- database (SQLite binaries) ----------------
db/*.db
db/*.db-journal
db/*.db-wal
db/*.db-shm
*.sqlite
*.sqlite3

# ---------------- sandbox / agent / dev artifacts ----------------
/skills/
/agent-ctx/
/.zscripts/
/tool-results/
/upload/
/download/
/examples/
/mini-services/

# ---------------- OS ----------------
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

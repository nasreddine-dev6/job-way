# ============================================================
#  JobWay — متغيرات البيئة
#  انسخ هذا الملف إلى .env:  cp .env.example .env
#  أو شغّل: bun run dev  (يقوم بإنشائه تلقائياً)
# ============================================================

# قاعدة بيانات SQLite (مسار نسبي — يعمل على أي جهاز)
DATABASE_URL="file:./db/dev.db"

# سر توقيع جلسات تسجيل الدخول — استبدله بسلسلة عشوائية طويلة في الإنتاج
SESSION_SECRET="jobway-dev-secret-change-in-production-please-use-a-long-random-string"

# (اختياري) قواعد بيانات بديلة:
# DATABASE_URL="postgresql://user:password@localhost:5432/jobway?schema=public"
# DATABASE_URL="mysql://user:password@localhost:3306/jobway"
